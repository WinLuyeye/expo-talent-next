NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
EMAIL_FROM="EXPO TALENT <inscriptions@votre-domaine-verifie.cd>"
TRACKING_SECRET=
APP_ORIGIN=http://localhost:3000
# False: progressive activation; true only after all admins have verified their TOTP.
ADMIN_MFA_REQUIRED=false

# Turnstile : ajouter les deux clés dans Vercel puis redéployer.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_REQUIRED=false

# CSP: validate report-only in a browser, then enable enforcement on Vercel.
CSP_NONCE_ENFORCE=false
# HTTPS antivirus service under your control (uploads fail closed without it).
FILE_SCAN_URL=
FILE_SCAN_TOKEN=
# Optional authenticated incident notification receiver; no raw IP or account.
SECURITY_WEBHOOK_URL=
SECURITY_WEBHOOK_TOKEN=

# V2.8 : true only after documented launch checks (mail, CSP, MFA, backup/restore, alerts).
LAUNCH_APPROVED=false

# Optional private incident recipient; uses the configured Resend sender instead of a separate webhook.
SECURITY_ALERT_EMAIL=
