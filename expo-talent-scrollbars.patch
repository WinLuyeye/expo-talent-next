diff --git a/app/globals.css b/app/globals.css
index 1c5ce1f..a870e70 100644
--- a/app/globals.css
+++ b/app/globals.css
@@ -10,3 +10,26 @@
 footer{flex-wrap:wrap}
 footer .developer-credit{flex:0 0 100%;width:100%;text-align:center;border-top:1px solid var(--line);padding-top:16px;color:var(--muted)}
 .developer-credit .developer-heart{color:var(--pink)}.developer-credit a{color:var(--yellow);font-weight:750}.developer-credit a:hover{text-decoration:underline}
+
+/* EXPO TALENT — scrollbars (site public et espace coordination). */
+:root{
+  --scroll-track:#0b1020;
+  --scroll-thumb:#626e89;
+  --scroll-hover:#8996b1;
+  --scroll-active:#ffe51d;
+}
+@media (forced-colors:none){
+  html,*{scrollbar-width:thin;scrollbar-color:var(--scroll-thumb) var(--scroll-track)}
+  /* Chromium / Safari : arrondis et états de survol. Les autres navigateurs
+     conservent les propriétés standard ci-dessus. */
+  @supports selector(::-webkit-scrollbar){
+    html,*{scrollbar-width:auto;scrollbar-color:auto}
+    ::-webkit-scrollbar{width:10px;height:10px}
+    ::-webkit-scrollbar-track{background:var(--scroll-track);border-radius:999px}
+    ::-webkit-scrollbar-thumb{background:var(--scroll-thumb);border:2px solid var(--scroll-track);border-radius:999px;min-height:32px;min-width:32px}
+    ::-webkit-scrollbar-thumb:hover{background:var(--scroll-hover)}
+    ::-webkit-scrollbar-thumb:active{background:var(--scroll-active)}
+    ::-webkit-scrollbar-corner{background:var(--scroll-track)}
+    ::-webkit-scrollbar-button{display:none;width:0;height:0}
+  }
+}
