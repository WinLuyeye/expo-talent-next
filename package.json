{
  "name": "expo-talent-iss-kin",
  "version": "2.7.1",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "test:smoke": "node scripts/smoke.mjs",
    "security:check": "node scripts/verify-lock.mjs && npm run typecheck && npm test && npm audit --audit-level=high",
    "prebuild": "npm run security:check",
    "backup": "node scripts/backup.mjs",
    "backup:verify": "node scripts/verify-backup.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@supabase/supabase-js": "^2.57.0",
    "@supabase/ssr": "^0.7.0",
    "framer-motion": "^12.23.0",
    "lucide-react": "^0.468.0",
    "resend": "^6.0.0",
    "recharts": "^3.1.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "exceljs": "4.4.0",
    "zod": "4.6.7",
    "server-only": "^0.0.1",
    "jsqr": "^1.4.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/qrcode": "^1.5.5",
    "tailwindcss": "^3.4.17",
    "postcss": "8.5.32",
    "autoprefixer": "^10.4.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
