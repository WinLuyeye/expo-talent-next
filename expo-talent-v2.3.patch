+return <><header className="nav admin-header"><a className="brand" href="/"><img src="/static/logo.webp" alt="ISS-KIN"/><span>EXPO<span className="yellow">TALENT</span><small>ESPACE COORDINATION</small></span></a><a href="/">← Site public</a></header><main className="admin-shell admin-redesign admin-v23">{loading?<p>Vérification de la session…</p>:!me?<section className="panel admin-login"><p className="eyebrow yellow flex items-center gap-2">ACCÈS RÉSERVÉ</p><h2>Connexion</h2><form className="stack" onSubmit={login}><label>Adresse e-mail<input name="email" type="email" required autoComplete="username"/></label><label>Mot de passe<input name="password" type="password" required autoComplete="current-password"/></label><button className="btn" disabled={busy}>Se connecter</button><p className="error" role="alert">{message}</p></form></section>:me.mfa.locked?<AdminMfa me={me} onChange={applyAccess} onLogout={logout}/>:<><div className="admin-console"><aside className="admin-sidebar"><div className="admin-sidebar-brand"><span className="workspace-dot"/><div><strong>Espace Coordination</strong><small>EXPO TALENT ISS-KIN</small></div></div><nav className="admin-navigation" aria-label="Navigation de l’administration">{['Pilotage','Gestion','Administration'].map(group=><div className="nav-group" key={group}><div className="admin-sidebar-label">{group}</div>{visibleTabs.filter(t=>t.group===group).map(({key,label})=><button type="button" key={key} className={tab===key?'active':''} aria-current={tab===key?'page':undefined} onClick={()=>selectTab(key)}><span>{label}</span></button>)}</div>)}</nav><div className="admin-sidebar-footer"><span className="workspace-dot"/> Accès réservé à la coordination</div></aside><div className="admin-content"><div className="coord-toolbar"><div className="coord-identity"><strong>Espace Coordination</strong><small>{me.role==='owner'?'Administrateur principal':'Gestionnaire des candidatures'}</small></div><form className="coord-search" onSubmit={e=>{e.preventDefault();setFilters({});selectTab('apps')}}><input aria-label="Rechercher un candidat" placeholder="Nom, matricule, référence…" value={search} onChange={e=>setSearch(e.target.value)}/><button type="submit" className="btn outline small">Rechercher</button></form><div className="coord-account"><span title={me.email}>{me.email}</span><div><button type="button" className="link" onClick={()=>void refreshDashboard()} disabled={busy}>Actualiser</button><button type="button" className="link" onClick={()=>void logout()}>Déconnexion</button></div></div></div><div className="admin-mobile-navigation"><label><span>Rubrique</span><select value={tab} onChange={e=>selectTab(e.target.value)}>{visibleTabs.map(t=><option value={t.key} key={t.key}>{t.label}</option>)}</select></label></div>{tab!=='overview'&&<div className="admin-breadcrumb">Coordination / <strong>{activeTab?.label||'Tableau de bord'}</strong></div>}<p className="admin-status" role="status">{message}</p>
 {tab==='traffic'&&me.role==='owner'&&<AdminTraffic/>}
 {tab==='security'&&<AdminMfa me={me} onChange={applyAccess} onLogout={logout}/>}
 {tab==='audit'&&me.role==='owner'&&<section className="panel stack"><h2>Journal d’audit</h2><p>Les 100 dernières modifications de statut, enregistrées avec l’identité de l’administrateur. Historique disponible à partir de cette version.</p><button className="btn outline" onClick={()=>void readAudit()}>Actualiser le journal</button>{audit.length===0?<p>Aucun changement enregistré.</p>:<div className="table-wrap"><table><thead><tr><th>Date (Kinshasa)</th><th>Administrateur</th><th>Candidature</th><th>Avant</th><th>Après</th></tr></thead><tbody>{audit.map(r=><tr key={r.id}><td>{new Date(r.created).toLocaleString('fr-FR',{timeZone:'Africa/Kinshasa'})}</td><td>{store.admins.find(a=>a.id===r.actor_id)?.email||r.actor_id}</td><td>{r.target_ref}</td><td>{r.details.before}</td><td>{r.details.after}</td></tr>)}</tbody></table></div>}</section>}
-{tab==='overview'&&<><div className="admin-section-heading"><div><h2>Activité de l’événement</h2><p>Vue globale des candidatures et de leur traitement.</p></div>{me.role==='owner'&&<button type="button" className="btn outline small" onClick={()=>selectTab('traffic')}><ChartNoAxesCombined size={16}/> Audience du site</button>}</div><div className="metrics">{[['Total',a.length],['Acceptées / confirmées',a.filter(accepted).length],['En attente',a.filter(r=>r.status===statuses[0]||r.status===statuses[1]).length],['Refusées',a.filter(r=>r.status===statuses[3]).length]].map(([k,v])=><div className="metric" key={k}><span>{k}</span><strong>{v}</strong></div>)}</div><div className="chart-grid"><Chart title="Par promotion" rows={a} keyOf={r=>String(r.data.promotion)}/><Chart title="Par catégorie" rows={a} keyOf={r=>String(r.data.categorie)}/><Chart title="Par filière" rows={a} keyOf={r=>String(r.data.filiere)}/><Chart title="Évolution quotidienne" rows={a} keyOf={r=>new Intl.DateTimeFormat('sv-SE',{timeZone:'Africa/Kinshasa',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date(r.created))}/><Chart title="Par statut" rows={a} keyOf={r=>r.status}/></div></>}
+{tab==='overview'&&<><AdminOverview applications={a} owner={me.role==='owner'} onTab={k=>{if(k==='apps'){setSearch('');setFilters({})}selectTab(k)}} onDetail={setDetail} reload={overviewReload}/><details className="panel overview-more" open={showOverviewDetails} onToggle={e=>setShowOverviewDetails(e.currentTarget.open)}><summary>Statistiques détaillées des candidatures</summary><p>Répartition par promotion, catégorie, filière, date et statut (démonstrations incluses).</p>{showOverviewDetails&&<div className="chart-grid"><Chart title="Par promotion" rows={a} keyOf={r=>String(r.data.promotion)}/><Chart title="Par catégorie" rows={a} keyOf={r=>String(r.data.categorie)}/><Chart title="Par filière" rows={a} keyOf={r=>String(r.data.filiere)}/><Chart title="Évolution quotidienne" rows={a} keyOf={r=>new Intl.DateTimeFormat('sv-SE',{timeZone:'Africa/Kinshasa',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date(r.created))}/><Chart title="Par statut" rows={a} keyOf={r=>r.status}/></div>}</details></>}
 {tab==='apps'&&<div className="panel"><h2>Candidatures</h2><div className="actions"><a className="btn outline" href="/api/admin/export.xlsx">Excel ↓</a><a className="btn outline" href="/api/admin/export.csv">CSV ↓</a><a className="btn outline" href="/api/admin/participants.csv">Participants acceptés ↓</a></div><div className="filters"><input aria-label="Rechercher" placeholder="Nom, matricule, référence" value={search} onChange={e=>setSearch(e.target.value)}/>{['promotion','filiere','categorie','status'].map(k=><select aria-label={labels[k]||'Statut'} value={filters[k]||''} key={k} onChange={e=>setFilters(f=>({...f,[k]:e.target.value}))}><option value="">{labels[k]||'Statut'} : tous</option>{(k==='status'?[...statuses]:[...new Set(a.map(r=>String(r.data[k])))]).map(v=><option key={v}>{v}</option>)}</select>)}</div><p>{filtered.length} candidature(s)</p><div className="table-wrap applications-table"><table><thead><tr>{['Référence','Nom / Matricule','Promotion','Catégorie','Statut','Action'].map(k=><th key={k}>{k}</th>)}</tr></thead><tbody>{filtered.map(r=><tr key={r.id}><td data-label="Référence">{r.id}</td><td data-label="Nom / Matricule"><strong>{fullName(r.data)}</strong><br/>{r.matricule}</td><td data-label="Promotion">{r.data.promotion}</td><td data-label="Catégorie">{r.data.categorie}</td><td data-label="Statut"><span className={"admin-badge "+(accepted(r)?"accepted":r.status===statuses[3]?"rejected":"pending")}>{r.status}</span></td><td data-label="Action"><button className="btn outline small" onClick={()=>setDetail(r.id)}>Détails ↗</button></td></tr>)}</tbody></table></div></div>}
 {tab==='verify'&&<div className="panel stack"><h2>Vérification des récépissés</h2><p>Scannez le QR à partir d’une photo ou saisissez la référence imprimée.</p><label>Lire une photo du QR<input type="file" accept="image/*" onChange={e=>{const f=e.target.files?.[0];if(f)void scanQR(f)}}/></label><form className="stack" onSubmit={e=>{e.preventDefault();setQrResult(a.find(r=>r.id===qr.trim().toUpperCase())||null)}}><label>Référence<input value={qr} onChange={e=>{setQr(e.target.value);setQrResult(undefined)}} required placeholder="EXPO-2026-…"/></label><button className="btn">Vérifier</button></form>{qrResult===null?<p className="error">Référence introuvable.</p>:qrResult&&<><p className="yellow">Référence valide : {qrResult.id} — {qrResult.status}</p><button className="btn outline" onClick={()=>setDetail(qrResult.id)}>Ouvrir la candidature</button></>}</div>}
 {tab==='mail'&&<div className="panel"><h2>Notifications et échecs d’envoi</h2><p>Transmission réelle via Resend. Les candidatures restent enregistrées en cas d’échec.</p><div className="table-wrap"><table><thead><tr><th>Référence</th><th>Destinataire / Objet</th><th>État</th><th>Action</th></tr></thead><tbody>{store.outbox.map(r=><tr key={r.id}><td>{r.app_id}</td><td>{r.recipient}<br/>{r.subject}</td><td>{({sent:'Envoyé',pending:'En attente',failed:'Échec',sending:'En cours'} as Record<string,string>)[r.state]}<br/><small>{r.error}</small></td><td>{r.state!=='sent'&&<button className="link" disabled={busy} onClick={()=>action('retry',{id:r.id})}>Réessayer</button>}</td></tr>)}</tbody></table>{!store.outbox.length&&<p>Aucun message.</p>}</div></div>}
