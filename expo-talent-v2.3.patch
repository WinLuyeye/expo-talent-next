+  const stats=report?summarizeTraffic(report):null;
+  const pending=applications.filter(r=>r.status===statuses[0]||r.status===statuses[1]).length;
+  const recent=[...applications].sort((a,b)=>Date.parse(b.created)-Date.parse(a.created)).slice(0,5);
+  const demo=applications.filter(r=>String(r.data.synthetic)==='true').length;
+  const devices=stats?.devices.filter(d=>d.pageviews>0)||[];
+  return <section className="overview-v23" aria-label="Vue d’ensemble">
+    <div className="overview-title"><div><h2>Vue d’ensemble</h2><p>Suivez les candidatures et l’activité de votre événement.</p></div>{owner&&<label className="overview-period">Audience <select value={days} onChange={e=>setDays(Number(e.target.value))} aria-label="Période de l’audience">{[7,30,90].map(d=><option key={d} value={d}>{d} derniers jours</option>)}</select></label>}</div>
+    <div className="overview-kpis">
+      <article className="overview-kpi"><span>Candidatures</span><strong>{number(applications.length)}</strong><small>Toutes les candidatures{demo?` · ${demo} démo`:''}</small></article>
+      <article className="overview-kpi kpi-green"><span>Acceptées / confirmées</span><strong>{number(applications.filter(accepted).length)}</strong><small>Toutes périodes</small></article>
+      <article className="overview-kpi kpi-yellow"><span>En attente</span><strong>{number(pending)}</strong><small>Reçues ou en examen</small></article>
+      <article className="overview-kpi kpi-violet"><span>{owner?'Pages vues':'Refusées'}</span><strong>{owner?(stats?number(stats.totals.pageviews):'—'):number(applications.filter(r=>r.status===statuses[3]).length)}</strong><small>{owner?`${days} derniers jours · mesurées`:'Toutes périodes'}</small></article>
+    </div>
