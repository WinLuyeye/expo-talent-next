+import {summarizeTraffic,type TrafficReport} from '@/lib/traffic-model';
+
+const number=(n:number)=>new Intl.NumberFormat('fr-FR').format(n);
+const day=(s:string)=>s.slice(8,10)+'/'+s.slice(5,7);
+const date=(s:string)=>new Intl.DateTimeFormat('fr-FR',{day:'2-digit',month:'short',year:'numeric',timeZone:'Africa/Kinshasa'}).format(new Date(s));
+const accepted=(r:Entry)=>r.status===statuses[2]||r.status===statuses[4];
+const colors=['#f6d92e','#9b83fa','#7394e8','#77839b'];
+type Props={applications:Entry[];owner:boolean;onTab:(tab:string)=>void;onDetail:(id:string)=>void;reload:number};
+export default function AdminOverview({applications,owner,onTab,onDetail,reload}:Props){
